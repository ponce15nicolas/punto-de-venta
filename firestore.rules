rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =====================================================
       HELPERS
    ===================================================== */

    function estaAutenticado() {
      return request.auth != null;
    }

    function emailAutenticado() {
      return estaAutenticado()
        ? request.auth.token.get("email", null)
        : null;
    }

    function mismoEmail(data) {
      return estaAutenticado()
        && emailAutenticado() != null
        && data.get("email", null) != null
        && data.get("email", null) == emailAutenticado();
    }

    function esCliente(clienteId, data) {
      return estaAutenticado()
        && (
          request.auth.uid == clienteId
          || mismoEmail(data)
        );
    }

    /*
     * Comprueba que el usuario autenticado
     * pertenece al cliente indicado.
     *
     * Soporta:
     * - documento clientes/{uid}
     * - cliente asociado por email
     */
    function perteneceAlCliente(clienteId) {
  return estaAutenticado()
    && (
      request.auth.uid == clienteId
      || (
        emailAutenticado() != null
        && exists(
          /databases/$(database)/documents/clientes/$(clienteId)
        )
        && get(
          /databases/$(database)/documents/clientes/$(clienteId)
        ).data.get("email", null) == emailAutenticado()
      )
    );
}

    /* =====================================================
       VALIDACIONES POS
    ===================================================== */

    function tipoProductoValido(tipoVenta) {
      return tipoVenta == "unidad"
        || tipoVenta == "peso"
        || tipoVenta == "precio-libre";
    }

    function productoValido(data) {
      return data.keys().hasAll([
          "barcode",
          "name",
          "tipoVenta",
          "price",
          "stock"
        ])
        && data.barcode is string
        && data.barcode.size() > 0
        && data.name is string
        && data.name.size() > 0
        && data.tipoVenta is string
        && tipoProductoValido(data.tipoVenta)
        && data.price is number
        && data.price >= 0
        && data.stock is number
        && data.stock >= 0;
    }

    function ventaValida(data) {
      return data.keys().hasAll([
          "id",
          "timestamp",
          "items",
          "total",
          "payment"
        ])
        && data.id is string
        && data.id.size() > 0
        && data.timestamp is string
        && data.items is list
        && data.items.size() > 0
        && data.total is number
        && data.total > 0
        && data.payment is map;
    }

    function estadoCajaValido(status) {
      return status == "open"
        || status == "closed";
    }

    function cajaValida(data) {
      return data.keys().hasAll([
          "id",
          "openTime",
          "openAmount",
          "status"
        ])
        && data.id is string
        && data.id.size() > 0
        && data.openTime is string
        && data.openAmount is number
        && data.openAmount >= 0
        && data.status is string
        && estadoCajaValido(data.status);
    }

    function configuracionPosPermitida(configId) {
      return configId == "pos"
        || configId == "migracion-pos-v1";
    }

    /* =====================================================
       CLIENTES
    ===================================================== */

    match /clientes/{clienteId} {

      /*
       * Lectura individual del cliente.
       */
      allow get: if esCliente(
        clienteId,
        resource.data
      );

      /*
       * Necesario para:
       *
       * where("email", "==", user.email)
       *
       * utilizado por useLicenseCheck.
       */
      allow list: if estaAutenticado()
        && mismoEmail(resource.data);

      /*
       * El frontend no puede modificar:
       *
       * - licencia
       * - vencimiento
       * - plan
       * - maxDispositivos
       * - dispositivosActivos
       * - authUids
       *
       * Eso continúa protegido por Cloud Functions.
       */
      allow create, update, delete: if false;

      /* ===================================================
         PRODUCTOS POS
      =================================================== */

      match /productos/{productoId} {

        /*
         * El cliente puede leer únicamente
         * los productos de su propia cuenta.
         *
         * El listener en tiempo real necesita
         * tanto get como list.
         */
        allow get, list: if perteneceAlCliente(
          clienteId
        );

        /*
         * Crear productos.
         *
         * También se utiliza durante la
         * migración desde localStorage.
         */
        allow create: if perteneceAlCliente(
            clienteId
          )
          && productoValido(
            request.resource.data
          );

        /*
         * Editar producto, reponer stock
         * y descontar stock durante ventas.
         */
        allow update: if perteneceAlCliente(
            clienteId
          )
          && productoValido(
            request.resource.data
          );

        /*
         * Necesario para eliminar productos
         * y para cambiar un código de barras,
         * donde se crea el nuevo documento
         * y se elimina el anterior.
         */
        allow delete: if perteneceAlCliente(
          clienteId
        );
      }

      /* ===================================================
         VENTAS POS
      =================================================== */

      match /ventas/{ventaId} {

        /*
         * Historial y sincronización
         * entre dispositivos.
         */
        allow get, list: if perteneceAlCliente(
          clienteId
        );

        /*
         * Una venta puede crearse desde
         * checkoutCloud o desde la migración.
         */
        allow create: if perteneceAlCliente(
            clienteId
          )
          && ventaValida(
            request.resource.data
          );

        /*
         * Las ventas quedan inmutables.
         *
         * Evitamos que un navegador pueda
         * alterar importes o tickets ya registrados.
         */
        allow update, delete: if false;
      }

      /* ===================================================
         CAJAS POS
      =================================================== */

      match /cajas/{cajaId} {

        /*
         * Caja actual + historial.
         */
        allow get, list: if perteneceAlCliente(
          clienteId
        );

        /*
         * Apertura de caja y migración.
         */
        allow create: if perteneceAlCliente(
            clienteId
          )
          && cajaValida(
            request.resource.data
          );

        /*
         * Se necesita actualizar la caja para:
         *
         * - acumular ventas
         * - métodos de pago
         * - cerrar turno
         */
        allow update: if perteneceAlCliente(
            clienteId
          )
          && cajaValida(
            request.resource.data
          );

        /*
         * Por ahora no permitimos borrar
         * cierres desde el navegador.
         *
         * Lo habilitaremos de forma controlada
         * cuando implementemos "eliminar historial".
         */
        allow delete: if false;
      }

      /* ===================================================
         CONFIGURACIÓN DEL POS
      =================================================== */

      match /configuracion/{configId} {

        /*
         * Únicamente existen dos documentos
         * permitidos desde el frontend:
         *
         * configuracion/pos
         * configuracion/migracion-pos-v1
         */
        allow get: if perteneceAlCliente(
            clienteId
          )
          && configuracionPosPermitida(
            configId
          );

        /*
         * No necesitamos consultas completas
         * sobre la colección configuración.
         */
        allow list: if false;

        /*
         * Permite:
         *
         * - nombre del negocio
         * - openCashSessionId
         * - estado de migración
         *
         * Esta colección está aislada de los
         * datos sensibles de licencia.
         */
        allow create, update: if perteneceAlCliente(
            clienteId
          )
          && configuracionPosPermitida(
            configId
          );

        allow delete: if false;
      }


      /* ===================================================
         CUENTAS POR COBRAR
      =================================================== */

      match /cuentasPorCobrar/{cuentaId} {

        /*
         * El cliente puede consultar su cartera de cobros
         * desde cualquier dispositivo autorizado.
         */
        allow get, list: if perteneceAlCliente(
          clienteId
        );

        /*
         * Altas y futuras modificaciones de deudas/pagos
         * pasan por Cloud Functions para conservar validación
         * y auditoría del operador.
         */
        allow create, update, delete: if false;
      }

      /* ===================================================
         AUDITORÍA / ACTIVIDAD
      =================================================== */

      match /auditoria/{eventoId} {

        /*
         * El cliente puede leer únicamente la auditoría
         * perteneciente a su propia cuenta.
         *
         * Necesario para la pantalla Actividad y su
         * listener en tiempo real.
         */
        allow get, list: if perteneceAlCliente(
          clienteId
        );

        /*
         * La auditoría sólo puede ser escrita desde
         * Cloud Functions / Admin SDK.
         */
        allow create, update, delete: if false;
      }

      /* ===================================================
         DISPOSITIVOS
      =================================================== */

      match /dispositivos/{deviceId} {

        /*
         * Continúa completamente bloqueado
         * para acceso directo desde frontend.
         *
         * Se administra mediante Cloud Functions.
         */
        allow read, write: if false;
      }

      /* ===================================================
         CONTROL DE SESIONES
      =================================================== */

      match /seguridad/{seguridadId} {

        /*
         * Contiene información interna de:
         *
         * - sesiones de dispositivos
         * - configuración de operadores internos
         * - deviceId
         * - sessionId
         * - lastSeen
         *
         * Sólo Cloud Functions puede gestionarlo.
         */
        allow read, write: if false;
      }

      /* ===================================================
         OPERADORES INTERNOS
      =================================================== */

      match /operadores/{operadorId} {

        /*
         * Contiene datos internos del personal del comercio:
         *
         * - nombre
         * - rol
         * - estado
         * - hash/salt de la clave
         *
         * El navegador no puede leer ni escribir estos documentos
         * directamente. Toda operación pasa por Cloud Functions,
         * que devuelve únicamente los campos públicos necesarios.
         */
        allow read, write: if false;
      }

      /* ===================================================
         SESIONES DE OPERADOR
      =================================================== */

      match /sesionesOperador/{sesionId} {

        /*
         * Contiene tokens hasheados y metadatos de la sesión
         * interna del administrador/encargado.
         *
         * Nunca se expone directamente al frontend.
         */
        allow read, write: if false;
      }
    }

    /* =====================================================
       ADMINS
    ===================================================== */

    match /admins/{adminId} {

      /*
       * AdminRoute puede comprobar solamente
       * el documento del usuario autenticado.
       */
      allow get: if estaAutenticado()
        && request.auth.uid == adminId;

      allow list: if false;

      /*
       * Administración únicamente desde backend
       * o Firebase Console.
       */
      allow create, update, delete: if false;
    }

    /* =====================================================
       PAGOS
    ===================================================== */

    match /pagos/{pagoId} {

      /*
       * El cliente solamente puede leer
       * pagos pertenecientes a su cuenta.
       */
      allow get, list: if perteneceAlCliente(
        resource.data.clienteId
      );

      /*
       * Los pagos se registran exclusivamente
       * mediante registrarPago Cloud Function.
       */
      allow create, update, delete: if false;
    }

    /* =====================================================
       TODO LO DEMÁS
    ===================================================== */

    /*
     * Fail closed.
     *
     * Toda colección o documento que no haya
     * sido autorizado explícitamente queda bloqueado.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}