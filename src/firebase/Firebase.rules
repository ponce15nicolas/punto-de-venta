rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =====================================================
       HELPERS
    ===================================================== */

    function estaAutenticado() {
      return request.auth != null;
    }

    function emailAutenticado() {
      return estaAutenticado()
        ? request.auth.token.get("email", null)
        : null;
    }

    function mismoEmail(data) {
      return estaAutenticado()
        && emailAutenticado() != null
        && data.get("email", null) != null
        && data.get("email", null) == emailAutenticado();
    }

    function esCliente(clienteId, data) {
      return estaAutenticado()
        && (
          request.auth.uid == clienteId
          || mismoEmail(data)
        );
    }

    /*
     * Comprueba que el usuario autenticado
     * pertenece al cliente indicado.
     *
     * IMPORTANTE:
     * get() devuelve el documento.
     * Para acceder a sus campos usamos .data.
     *
     * Si request.auth.uid coincide directamente
     * con clienteId no necesitamos consultar el email.
     */
    function perteneceAlCliente(clienteId) {
  return estaAutenticado()
    && (
      request.auth.uid == clienteId
      || (
        emailAutenticado() != null
        && exists(
          /databases/$(database)/documents/clientes/$(clienteId)
        )
        && get(
          /databases/$(database)/documents/clientes/$(clienteId)
        ).data.get("email", null) == emailAutenticado()
      )
    );
}

    /* =====================================================
       VALIDACIONES POS
    ===================================================== */

    function tipoProductoValido(tipoVenta) {
      return tipoVenta == "unidad"
        || tipoVenta == "peso"
        || tipoVenta == "precio-libre";
    }

    function productoValido(data) {
      return data.keys().hasAll([
          "barcode",
          "name",
          "tipoVenta",
          "price",
          "stock"
        ])
        && data.barcode is string
        && data.barcode.size() > 0
        && data.name is string
        && data.name.size() > 0
        && data.tipoVenta is string
        && tipoProductoValido(data.tipoVenta)
        && data.price is number
        && data.price >= 0
        && data.stock is number
        && data.stock >= 0;
    }

    function ventaValida(data) {
      return data.keys().hasAll([
          "id",
          "timestamp",
          "items",
          "total",
          "payment"
        ])
        && data.id is string
        && data.id.size() > 0
        && data.timestamp is string
        && data.items is list
        && data.items.size() > 0
        && data.total is number
        && data.total > 0
        && data.payment is map;
    }

    function estadoCajaValido(status) {
      return status == "open"
        || status == "closed";
    }

    function cajaValida(data) {
      return data.keys().hasAll([
          "id",
          "openTime",
          "openAmount",
          "status"
        ])
        && data.id is string
        && data.id.size() > 0
        && data.openTime is string
        && data.openAmount is number
        && data.openAmount >= 0
        && data.status is string
        && estadoCajaValido(data.status);
    }

    function configuracionPosPermitida(configId) {
      return configId == "pos"
        || configId == "migracion-pos-v1";
    }

    /* =====================================================
       CLIENTES
    ===================================================== */

    match /clientes/{clienteId} {

      allow get: if esCliente(
        clienteId,
        resource.data
      );

      allow list: if estaAutenticado()
        && mismoEmail(resource.data);

      /*
       * El cliente no puede modificar
       * directamente su licencia.
       */
      allow create, update, delete: if false;

      /* ===================================================
         PRODUCTOS
      =================================================== */

      match /productos/{productoId} {

        allow get, list: if perteneceAlCliente(
          clienteId
        );

        /*
         * Altas, cambios, bajas y migraciones se ejecutan
         * exclusivamente mediante Cloud Functions / Admin SDK.
         */
        allow create, update, delete: if false;
      }

      /* ===================================================
         VENTAS
      =================================================== */

      match /ventas/{ventaId} {

        allow get, list: if perteneceAlCliente(
          clienteId
        );

        /*
         * El alta normal y la migración de ventas se ejecutan
         * exclusivamente mediante Cloud Functions / Admin SDK.
         * Desde el navegador no se admiten escrituras directas.
         */
        allow create, update, delete: if false;
      }

      /* ===================================================
         CAJAS
      =================================================== */

      match /cajas/{cajaId} {

        allow get, list: if perteneceAlCliente(
          clienteId
        );

        /*
         * Aperturas, cierres, acumulación de ventas y migraciones
         * se ejecutan exclusivamente mediante Cloud Functions /
         * Admin SDK.
         */
        allow create, update, delete: if false;
      }

      /* ===================================================
         CONFIGURACIÓN POS
      =================================================== */

      match /configuracion/{configId} {

        allow get: if perteneceAlCliente(
            clienteId
          )
          && configuracionPosPermitida(
            configId
          );

        allow list: if false;

        /*
         * El nombre del negocio, la caja abierta y el estado de
         * migración se escriben exclusivamente mediante
         * Cloud Functions / Admin SDK.
         */
        allow create, update, delete: if false;
      }

      /* ===================================================
         DISPOSITIVOS
      =================================================== */

      match /dispositivos/{deviceId} {

        /*
         * Solamente Cloud Functions administra
         * dispositivos y sesiones.
         */
        allow read, write: if false;
      }

      /* ===================================================
         SEGURIDAD / SESIONES
      =================================================== */

      match /seguridad/{seguridadId} {

        /*
         * Solamente Cloud Functions.
         */
        allow read, write: if false;
      }
    }

    /* =====================================================
       ADMINS
    ===================================================== */

    match /admins/{adminId} {

      allow get: if estaAutenticado()
        && request.auth.uid == adminId;

      allow list: if false;

      allow create, update, delete: if false;
    }

    /* =====================================================
       PAGOS
    ===================================================== */

    match /pagos/{pagoId} {

      allow get, list: if perteneceAlCliente(
        resource.data.clienteId
      );

      allow create, update, delete: if false;
    }

    /* =====================================================
       TODO LO DEMÁS
    ===================================================== */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
